<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guruai</groupId>
        <artifactId>guruai-microservices</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>study-agent-service</artifactId>
    <name>GuruAI Study Agent Service</name>
    <description>
        The AI Brain + Session Manager. Absorbed chat-service (session/message CRUD)
        and learning-path-service (study plan generation) for leaner architecture.
        Groq chat (llama-3.1-8b-instant); vector search delegated to
        document-service over HTTP. CRAG pipeline, @Tool agent, SSE streaming,
        learning path generation.
        Port: 8083  |  DB: agent_db (PostgreSQL) — sessions + messages
    </description>

    <dependencies>
        <!-- Web (SSE streaming + REST) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebFlux — WebClient (service-to-service HTTP) + Flux return type
             for the SSE streaming endpoint. The servlet stack (starter-web)
             stays the primary runtime; Spring Boot handles both being present. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- JPA + PostgreSQL — owns agent_db (sessions + messages) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI — Groq via OpenAI interface (chat + CRAG grading + ReAct) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- NOTE: no pgvector / Gemini-embedding dependencies here on purpose.
             This service never touches document_db or embeddings directly —
             all vector search goes over HTTP to document-service (see
             DocumentServiceClient + CragService). An earlier revision had
             spring-ai-starter-vector-store-pgvector + google-genai here,
             which (a) was dead weight and (b) put two ChatModels on the
             classpath, breaking ChatClient.Builder auto-configuration. -->

        <!-- Kafka — publish chat.message.saved -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Flyway — manages agent_db schema (sessions + messages tables) -->
        <!-- Spring Boot 4's Flyway AUTO-CONFIGURATION module. Critical:
             in Boot 4 the auto-config that actually triggers migrations at
             startup was split out of the core autoconfigure jar into this
             module. With only flyway-core on the classpath, Flyway silently
             never runs, the schema stays empty, and Hibernate's
             ddl-auto=validate kills the service with "missing table" on
             every boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Common -->
        <dependency>
            <groupId>com.guruai</groupId>
            <artifactId>common-lib</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable fat-jar repackaging — see api-gateway/pom.xml for
                 why every service module must declare this explicitly. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
