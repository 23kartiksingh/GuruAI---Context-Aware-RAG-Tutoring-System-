<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guruai</groupId>
        <artifactId>guruai-microservices</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>knowledge-service</artifactId>
    <name>GuruAI Knowledge Service</name>
    <description>
        Student mastery tracker using Exponential Moving Average (alpha=0.3).
        Consumes quiz.completed and flashcard.reviewed Kafka events to update
        per-topic EMA scores. Publishes mastery.dropped when a topic regresses.
        Port: 8085  |  DB: knowledge_db (PostgreSQL)
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Spring AI — Groq via OpenAI interface. Added for
             TopicCanonicalizerService: this service was pure data/CRUD until
             it needed a cheap classification call to cumulate similarly-worded
             topics under one canonical name instead of fragmenting them. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- Spring Boot 4's Flyway AUTO-CONFIGURATION module. Critical:
             in Boot 4 the auto-config that actually triggers migrations at
             startup was split out of the core autoconfigure jar into this
             module. With only flyway-core on the classpath, Flyway silently
             never runs, the schema stays empty, and Hibernate's
             ddl-auto=validate kills the service with "missing table" on
             every boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guruai</groupId>
            <artifactId>common-lib</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable fat-jar repackaging — see api-gateway/pom.xml for
                 why every service module must declare this explicitly. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
