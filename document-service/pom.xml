<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.guruai</groupId>
        <artifactId>guruai-microservices</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>document-service</artifactId>
    <name>GuruAI Document Service</name>
    <description>
        Document upload (PDF/DOCX/TXT/images), Apache Tika parsing, chunking,
        Groq chat (llama-3.1-8b-instant) + Gemini embeddings (gemini-embedding-001), pgvector storage, Hybrid Retrieval (Dense + BM25 + RRF),
        CRAG relevance grading, Redis LRU retriever cache.
        Port: 8082  |  DB: document_db (PostgreSQL + pgvector)
    </description>

    <dependencies>
        <!-- Web + Multipart file upload -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA + PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring AI — Google Gemini, this service's ONLY AI provider:
             gemini-embedding-001 for vector embeddings + gemini-2.5-flash for
             once-per-upload topic extraction. Part of the deliberate free-tier
             load split: Gemini owns indexing-time AI (this service), Groq owns
             conversation-time AI (study-agent/quiz/flashcard/memory services).
             Exactly one provider per service also means exactly one ChatModel
             and one EmbeddingModel on the classpath — the previous revision
             had the Groq/OpenAI starter here too, which broke ChatClient.Builder
             and VectorStore auto-configuration with duplicate beans. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai</artifactId>
        </dependency>

        <!-- Spring AI — Google GenAI embeddings. The chat starter above only
             brings in GoogleGenAiChatModel; the EmbeddingModel bean that
             PgVectorStoreAutoConfiguration needs (GoogleGenAiTextEmbeddingModel)
             lives in this separate starter. Without it, Spring can't find any
             EmbeddingModel candidate and vectorStore bean creation fails at
             startup ("No qualifying bean of type EmbeddingModel"). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-google-genai-embedding</artifactId>
        </dependency>

        <!-- Spring AI — pgvector vector store -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- Apache Tika — parse PDF, DOCX, TXT, images with OCR -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
        </dependency>

        <!-- Redis — LRU retriever cache (32-slot, ported from Python) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Kafka — publish document.indexed -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Flyway -->
        <!-- Spring Boot 4's Flyway AUTO-CONFIGURATION module. Critical:
             in Boot 4 the auto-config that actually triggers migrations at
             startup was split out of the core autoconfigure jar into this
             module. With only flyway-core on the classpath, Flyway silently
             never runs, the schema stays empty, and Hibernate's
             ddl-auto=validate kills the service with "missing table" on
             every boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Common -->
        <dependency>
            <groupId>com.guruai</groupId>
            <artifactId>common-lib</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Executable fat-jar repackaging — see api-gateway/pom.xml for
                 why every service module must declare this explicitly. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
