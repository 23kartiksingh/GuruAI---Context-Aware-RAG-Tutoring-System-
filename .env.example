# ================================================================
# GuruAI — Environment Variables Template
# ================================================================
# COPY this file to .env and fill in your actual values.
# NEVER commit the .env file to git (it's in .gitignore).
#
#   cp .env.example .env
# ================================================================

# ================================================================
# AI PROVIDER SPLIT (deliberate — spreads load over two free tiers)
#   Groq   = conversation-time AI: tutor chat, CRAG grading,
#            quiz generation, flashcard generation, memory extraction
#   Gemini = indexing-time AI: document embeddings + topic extraction
# One provider per service, so neither free quota carries everything.
# ================================================================

# ── Groq API Key ──────────────────────────────────────────────
# Get your FREE key from: https://console.groq.com
# Used by: Study Agent, Quiz, Flashcard, User Memory
# Model: llama-3.1-8b-instant (extremely fast, free tier available)
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini API Key ─────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Used by: Document Service ONLY (embeddings for pgvector +
#          once-per-upload topic extraction via gemini-2.5-flash)
# Models: models/gemini-embedding-001 (768-dim), gemini-2.5-flash
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Google OAuth2 ("Sign in with Google") ─────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create Credentials → OAuth client ID → Application type: Web application
# 3. Authorized redirect URIs → add exactly:
#      http://localhost:8080/auth/oauth2/callback/google
#    (must match OAUTH2_REDIRECT_BASE_URL below, byte-for-byte)
# 4. Copy the generated Client ID / Client secret here.
# Leave both blank to leave the feature dormant — password login/register
# still work fine without this.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public gateway origin the browser is redirected through during the Google
# handshake (auth-service itself has no published host port). Only change
# this if the gateway isn't reachable at localhost:8080 — and update the
# Authorized redirect URI in Google Cloud Console to match.
OAUTH2_REDIRECT_BASE_URL=http://localhost:8080

# Where the browser lands once the Google handshake finishes. Defaults are
# derived from FRONTEND_URL below if left unset.
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/dashboard
OAUTH2_FAILURE_REDIRECT_URL=http://localhost:3000/login?error=oauth

# ── JWT Configuration ────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_long_replace_this_now

# Access token lifetime: 1 hour (3600000 ms)
JWT_ACCESS_EXPIRY_MS=3600000

# Refresh token lifetime: 14 days (1209600000 ms)
JWT_REFRESH_EXPIRY_MS=1209600000

# ── Internal Service Secret ───────────────────────────────────────
# Shared between api-gateway and every downstream service. The gateway
# stamps this on every request it proxies; each service's
# InternalAccessFilter rejects any request missing it — this is what
# stops someone from bypassing the gateway and calling a service
# directly to forge X-User-Id. Generate with: openssl rand -base64 32
INTERNAL_SERVICE_SECRET=another_long_random_secret_min_32_chars_replace_this

# ── Database Password ────────────────────────────────────────────
# One Postgres instance hosts all 8 per-service databases (see
# scripts/init-databases.sql). Same user/pass across databases.
DB_USER=guruai
DB_PASSWORD=guruai_secret_2026

# ── Redis Password ───────────────────────────────────────────────
REDIS_PASSWORD=guruai_redis_2026

# ── Admin UI Passwords ───────────────────────────────────────────
# Redis Commander web UI (localhost:8082)
REDIS_UI_PASSWORD=admin123

# Kafka UI web UI (localhost:9000)
KAFKA_UI_PASSWORD=admin123

# ── Service Ports (if you need to change defaults) ───────────────
# API Gateway (all traffic enters here)
GATEWAY_PORT=8080

# Individual services (used by IDE run configs, not Docker).
# study-agent-service absorbed the old chat-service and
# learning-path-service during the 11 -> 9 consolidation, so there's
# no separate port for either anymore.
AUTH_SERVICE_PORT=8081
DOCUMENT_SERVICE_PORT=8082
STUDY_AGENT_PORT=8083
KNOWLEDGE_SERVICE_PORT=8085
QUIZ_SERVICE_PORT=8086
FLASHCARD_SERVICE_PORT=8087
MEMORY_SERVICE_PORT=8088
NOTIFICATION_SERVICE_PORT=8090

# React frontend
FRONTEND_PORT=3000

# Baked into the frontend's JS bundle at Docker build time (Vite env vars
# aren't readable at container runtime) — only need to change these if the
# gateway isn't reachable at localhost:8080 from the browser.
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080

# ── Frontend origin (CORS) ────────────────────────────────────────
# The gateway only allows credentialed cross-origin requests (needed
# for the httpOnly auth cookies) from this exact origin.
FRONTEND_URL=http://localhost:3000

# ── Infrastructure UI Ports ──────────────────────────────────────
# Access Redis Commander at http://localhost:8082 (admin / REDIS_UI_PASSWORD)
# Access Kafka UI at        http://localhost:9000 (admin / KAFKA_UI_PASSWORD)
# Access Kafka directly at  localhost:9094 (external listener)
